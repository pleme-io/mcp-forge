// -- MCP Server --

#[derive(Debug, Clone)]
struct MatrixApiMcp {
    client: MatrixApiClient,
    tool_router: ToolRouter<Self>,
}

#[tool_router]
impl MatrixApiMcp {
    fn new() -> Result<Self, String> {
        let config = MatrixApiConfig::load();
        let api_key = auth::resolve_api_key(None, &config).map_err(|e| e.to_string())?;
        let client =
            MatrixApiClient::new(&config.api_url, &api_key).map_err(|e| e.to_string())?;

        Ok(Self {
            client,
            tool_router: Self::tool_router(),
        })
    }

    #[tool(description = "static_get summary")]
    async fn static_get(&self, Parameters(_): Parameters<serde_json::Value>) -> String {
        match self.client.static_get().await {
            Ok(result) => format::format_static_get(&result),
            Err(e) => kotae::Answer::blind(e.to_string()).render(),
        }
    }

    #[tool(description = "static_get_empty summary")]
    async fn static_get_empty(&self, Parameters(_): Parameters<serde_json::Value>) -> String {
        match self.client.static_get_empty().await {
